    "web": { "id": "v1-byte/miko-web-lora", "status": "pending_training", "dataset": "dataset_template/web/" },
    "apk": { "id": "v1-byte/miko-apk-lora", "status": "pending_training", "dataset": "dataset_template/apk/" },
    "security": { "id": "v1-byte/miko-security-lora", "status": "pending_training", "dataset": "dataset_template/security/" },
    "coding": { "id": "v1-byte/miko-coding-lora", "status": "pending_training", "dataset": "dataset_template/coding/" }
  },
  "recommended_path": {
    "client": "runtime/online-client.mjs + set endpoint Worker di APK",
