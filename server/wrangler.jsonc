{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miko-ai-online-router",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "vars": {
    "ALLOWED_ORIGINS": "capacitor://localhost,http://localhost,https://localhost,http://127.0.0.1",
    "MIKO_MODEL_DEFAULT": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_WEB": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_SERVER": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_API": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_APK": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_SECURITY": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "MIKO_MODEL_CODING": "Qwen/Qwen2.5-Coder-7B-Instruct"
  },
  "ratelimits": [
    {
      "name": "MIKO_RATE_LIMITER",
      "namespace_id": "738491205",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
